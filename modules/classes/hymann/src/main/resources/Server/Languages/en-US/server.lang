# Hymann item names and descriptions used by MMOSkillTree tooltips.
items.Hymann_Skill_XP.name = Stormbound Study
items.Hymann_Skill_XP.description = Increases experience gained from hits with Hymann armaments.
items.Hymann_Skill_Damage.name = Armament Mastery
items.Hymann_Skill_Damage.description = Increases flat damage dealt with Mjolnir, Captain shields and maces.
items.Hymann_Skill_Lifesteal.name = Storm Leech
items.Hymann_Skill_Lifesteal.description = Restores health from damage dealt with Hymann armaments.
items.Hymann_Skill_Combo.name = Thunder Combo
items.Hymann_Skill_Combo.description = Increases combo damage dealt with Hymann armaments.
items.Hymann_Skill_Cooldown.name = Storm Rhythm
items.Hymann_Skill_Cooldown.description = Reduces the cooldown of Hymann abilities.
items.Hymann_Skill_Stamina.name = Aegis Reserve
items.Hymann_Skill_Stamina.description = Increases maximum stamina for sustained melee combat and blocking.
items.Hymann_Skill_Fall_Guard.name = Skyfall Guard
items.Hymann_Skill_Fall_Guard.description = Reduces fall damage after leaps and aerial movement.
items.Hymann_Skill_Block.name = Aegis Guard
items.Hymann_Skill_Block.description = Reduces incoming damage and reinforces Hymann's shield-focused defense.
items.Hymann_Skill_Stamina_Regen.name = Windrunner
items.Hymann_Skill_Stamina_Regen.description = Increases stamina regeneration while using Hymann armaments.
items.Hymann_Skill_Mana_Regen.name = Stormwell
items.Hymann_Skill_Mana_Regen.description = Increases mana regeneration while using Hymann armaments.
items.Hymann_Skill_Sorcery.name = Lightning Lore
items.Hymann_Skill_Sorcery.description = Adds magic damage to Hymann lightning abilities.
items.Hymann_Skill_Crit.name = Thunderforged Fury
items.Hymann_Skill_Crit.description = Increases Hymann's critical damage.
items.Hymann_Skill_Thunder_Step.name = Lightning Step
items.Hymann_Skill_Thunder_Step.description = Teleport to a visible hostile enemy within 25 blocks, then deal 75 damage, stun for 1.5 seconds and shock enemies in a 6-block radius. Costs 35 Mana. Cooldown: 10 seconds.
items.Hymann_Skill_Storm_Fury.name = Storm Fury
items.Hymann_Skill_Storm_Fury.description = For 10 seconds, increase Mana and Signature Energy regeneration and reduce incoming damage. Costs 50 Mana. Cooldown: 20 seconds.
items.Hymann_Skill_Thunder_Aegis.name = Thunder Aegis
items.Hymann_Skill_Thunder_Aegis.description = Fully heal nearby allies and strike hostile enemies in a 9-block radius for 250 damage with a 2-second stun. Costs 75 Mana. Cooldown: 30 seconds.
items.Hymann_Skill_Stormbreaker.name = Stormbreaker
items.Hymann_Skill_Stormbreaker.description = Hymann passive ability: strengthens close-range lightning, survival and Mjolnir-and-shield combat.
