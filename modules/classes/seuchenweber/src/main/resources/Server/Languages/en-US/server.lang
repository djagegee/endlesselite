# Seuchenweber item names and descriptions.
items.Seuchenweber_Skill_XP.name=Seuchenweber
items.Seuchenweber_Skill_XP.description=Mastery of the Cosmic Ruin Spellbook and plague-woven abilities.
items.Seuchenweber_Skill_Seal_Of_Decay.name=Seal of Decay
items.Seuchenweber_Skill_Seal_Of_Decay.description=Imprint a hostile target with two Nekrotoxin stacks. The decay deals damage over time rather than burst damage.
items.Seuchenweber_Skill_Astral_Rift.name=Astral Rift
items.Seuchenweber_Skill_Astral_Rift.description=Step through a visible rift and leave a short-lived breach that infects nearby hostile creatures.
items.Seuchenweber_Skill_Chronoblight.name=Chronoblight
items.Seuchenweber_Skill_Chronoblight.description=Deepen your own existing marks. A fully marked target can be briefly controlled when Perfect Utils is available.
items.Seuchenweber_Skill_Necrotoxic_Mastery.name=Blight Breath
items.Seuchenweber_Skill_Necrotoxic_Mastery.description=Infects nearby enemies with one Nekrotoxin stack every 2 seconds.
items.Seuchenweber_Skill_Astral_Echo.name=Astral Echo
items.Seuchenweber_Skill_Astral_Echo.description=Allows a capped Nekrotoxin tick to mark one nearby hostile creature.
items.Seuchenweber_Skill_Soul_Diagnosis.name=Soul Diagnosis
items.Seuchenweber_Skill_Soul_Diagnosis.description=Reveals the state of heavily marked targets.
items.Seuchenweber_Skill_Relic_Attunement.name=Relic Attunement
items.Seuchenweber_Skill_Relic_Attunement.description=Naturally expiring full marks return a small amount of mana and cooldown time.
server.classes.seuchenweber.name=Seuchenweber
server.classes.seuchenweber.description=An occult mage who controls the fight with astral seals and owner-bound Nekrotoxin.
seuchenweber.tree.seuchenweber_seal_of_decay.name=Seal of Decay
seuchenweber.tree.seuchenweber_seal_of_decay.description=Active · Level 2: Marks a hostile target with Nekrotoxin.
seuchenweber.tree.seuchenweber_passive_necrotoxic_mastery.name=Necrotoxic Mastery
seuchenweber.tree.seuchenweber_passive_necrotoxic_mastery.description=Passive · Level 10: Increases Seuchenweber poison damage.
seuchenweber.tree.seuchenweber_astral_rift.name=Astral Rift
seuchenweber.tree.seuchenweber_astral_rift.description=Active · Level 25: Teleports through a rift and infects nearby enemies.
seuchenweber.tree.seuchenweber_passive_astral_echo.name=Astral Echo
seuchenweber.tree.seuchenweber_passive_astral_echo.description=Passive · Level 40: Transfers a bounded mark to a nearby enemy.
seuchenweber.tree.seuchenweber_chronoblight.name=Chronoblight
seuchenweber.tree.seuchenweber_chronoblight.description=Active · Level 55: Deepens your own Nekrotoxin marks.
seuchenweber.tree.seuchenweber_passive_soul_diagnosis.name=Soul Diagnosis
seuchenweber.tree.seuchenweber_passive_soul_diagnosis.description=Passive · Level 70: Shows heavily marked targets only to their owner.
seuchenweber.tree.seuchenweber_passive_relic_attunement.name=Relic Attunement
seuchenweber.tree.seuchenweber_passive_relic_attunement.description=Passive · Level 90: Naturally expiring full marks refund resources.
