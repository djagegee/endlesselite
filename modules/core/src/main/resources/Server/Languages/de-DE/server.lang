# Endless Elite shared Hytale server localization.
# Single asset owner; feature sections retained from Hymann and Seuchenweber.

# --- Hymann ---
# Hymann-Gegenstandsnamen und -beschreibungen für MMOSkillTree-Tooltips.
items.Hymann_Skill_XP.name = Sturmerprobtes Studium
items.Hymann_Skill_XP.description = Erhöht die Erfahrung aus Treffern mit Hymann-Reliktwaffen.
items.Hymann_Skill_Damage.name = Reliktmeisterschaft
items.Hymann_Skill_Damage.description = Erhöht den Grundschaden mit Mjolnir, Captain-Schilden und Streitkolben.
items.Hymann_Skill_Lifesteal.name = Sturmzehrer
items.Hymann_Skill_Lifesteal.description = Stellt durch Schaden mit Hymann-Reliktwaffen Leben wieder her.
items.Hymann_Skill_Combo.name = Donnerkombo
items.Hymann_Skill_Combo.description = Erhöht den Komboschaden mit Hymann-Reliktwaffen.
items.Hymann_Skill_Cooldown.name = Sturmrhythmus
items.Hymann_Skill_Cooldown.description = Verkürzt die Abklingzeit der Hymann-Fähigkeiten.
items.Hymann_Skill_Stamina.name = Aegisreserve
items.Hymann_Skill_Stamina.description = Erhöht die maximale Ausdauer für anhaltenden Nahkampf und Blocken.
items.Hymann_Skill_Fall_Guard.name = Himmelssturzschutz
items.Hymann_Skill_Fall_Guard.description = Verringert Fallschaden nach Sprüngen und Bewegungen in der Luft.
items.Hymann_Skill_Block.name = Aegiswache
items.Hymann_Skill_Block.description = Verringert eingehenden Schaden und stärkt Hymanns schildbasierte Verteidigung.
items.Hymann_Skill_Stamina_Regen.name = Windläufer
items.Hymann_Skill_Stamina_Regen.description = Erhöht die Ausdauerregeneration beim Einsatz von Hymann-Reliktwaffen.
items.Hymann_Skill_Mana_Regen.name = Sturmquell
items.Hymann_Skill_Mana_Regen.description = Erhöht die Manaregeneration beim Einsatz von Hymann-Reliktwaffen.
items.Hymann_Skill_Sorcery.name = Blitzkunde
items.Hymann_Skill_Sorcery.description = Fügt Hymanns Blitzfähigkeiten Magieschaden hinzu.
items.Hymann_Skill_Crit.name = Donnergeschmiedeter Zorn
items.Hymann_Skill_Crit.description = Erhöht Hymanns kritischen Schaden.
items.Hymann_Skill_Thunder_Step.name = Donnerschritt
items.Hymann_Skill_Thunder_Step.description = Teleportiert dich zu einem sichtbaren Gegner in bis zu 25 Blöcken Entfernung, verursacht 75 Schaden, betäubt 1,5 Sekunden und schockt Gegner in 6 Blöcken Umkreis. Kostet 35 Mana. Abklingzeit: 10 Sekunden.
items.Hymann_Skill_Storm_Fury.name = Sturmfurie
items.Hymann_Skill_Storm_Fury.description = Erhöht 10 Sekunden lang Mana- und Signaturenergie-Regeneration und verringert eingehenden Schaden. Kostet 50 Mana. Abklingzeit: 20 Sekunden.
items.Hymann_Skill_Thunder_Aegis.name = Donneraegis
items.Hymann_Skill_Thunder_Aegis.description = Heilt Verbündete in der Nähe vollständig und trifft Gegner in 9 Blöcken Umkreis mit 250 Schaden und 2 Sekunden Betäubung. Kostet 75 Mana. Abklingzeit: 30 Sekunden.
items.Hymann_Skill_Stormbreaker.name = Sturmspalter
items.Hymann_Skill_Stormbreaker.description = Hymann-Passivfähigkeit: stärkt Blitzschaden im Nahbereich, Überleben sowie den Kampf mit Mjolnir und Schild.

# --- Seuchenweber ---
# Namen und Beschreibungen des Seuchenwebers.
items.Seuchenweber_Skill_XP.name=Seuchenweber
items.Seuchenweber_Skill_XP.description=Meisterschaft des Cosmic Ruin Spellbooks und der seuchengewebten Fähigkeiten.
items.Seuchenweber_Skill_Seal_Of_Decay.name=Siegel der Fäulnis
items.Seuchenweber_Skill_Seal_Of_Decay.description=Prägt einem feindlichen Ziel zwei Nekrotoxin-Stapel ein. Die Fäulnis verursacht Schaden über Zeit statt Burstschaden.
items.Seuchenweber_Skill_Astral_Rift.name=Astralriss
items.Seuchenweber_Skill_Astral_Rift.description=Schreite durch einen sichtbaren Riss und hinterlasse eine kurze Bresche, die nahe feindliche Kreaturen infiziert.
items.Seuchenweber_Skill_Chronoblight.name=Chronofäule
items.Seuchenweber_Skill_Chronoblight.description=Vertieft deine bestehenden Zeichen. Ein voll markiertes Ziel kann kurz kontrolliert werden, falls Perfect Utils verfügbar ist.
items.Seuchenweber_Skill_Necrotoxic_Mastery.name=Pesthauch
items.Seuchenweber_Skill_Necrotoxic_Mastery.description=Infiziert nahe Feinde alle 2 Sekunden mit einem Nekrotoxin-Stapel.
items.Seuchenweber_Skill_Astral_Echo.name=Astrales Echo
items.Seuchenweber_Skill_Astral_Echo.description=Erlaubt einem begrenzten Nekrotoxin-Tick, eine nahe feindliche Kreatur zu markieren.
items.Seuchenweber_Skill_Soul_Diagnosis.name=Seelendiagnose
items.Seuchenweber_Skill_Soul_Diagnosis.description=Zeigt den Zustand stark markierter Ziele an.
items.Seuchenweber_Skill_Relic_Attunement.name=Reliktresonanz
items.Seuchenweber_Skill_Relic_Attunement.description=Natürlich ablaufende volle Zeichen geben etwas Mana und Abklingzeit zurück.
server.classes.seuchenweber.name=Seuchenweber
server.classes.seuchenweber.description=Ein okkulter Magier, der Kämpfe mit Astralsiegeln und besitzergebundenem Nekrotoxin kontrolliert.
seuchenweber.tree.seuchenweber_seal_of_decay.name=Siegel der Fäulnis
seuchenweber.tree.seuchenweber_seal_of_decay.description=Aktiv · Ab Seuchenweber-Level 2: Markiert ein feindliches Ziel mit Nekrotoxin.
seuchenweber.tree.seuchenweber_passive_necrotoxic_mastery.name=Pesthauch
seuchenweber.tree.seuchenweber_passive_necrotoxic_mastery.description=Passiv · Ab Level 1: Alle 2 Sekunden erhalten feindliche Ziele im Umkreis von 8 Blöcken einen Nekrotoxin-Stapel.
seuchenweber.tree.seuchenweber_astral_rift.name=Astralriss
seuchenweber.tree.seuchenweber_astral_rift.description=Aktiv · Ab Level 25: Teleportiert durch einen Riss und infiziert nahe Feinde.
seuchenweber.tree.seuchenweber_passive_astral_echo.name=Astrales Echo
seuchenweber.tree.seuchenweber_passive_astral_echo.description=Passiv · Ab Level 40: Überträgt begrenzt ein Zeichen auf einen nahen Feind.
seuchenweber.tree.seuchenweber_chronoblight.name=Chronofäule
seuchenweber.tree.seuchenweber_chronoblight.description=Aktiv · Ab Level 55: Vertieft eigene Nekrotoxin-Zeichen.
seuchenweber.tree.seuchenweber_passive_soul_diagnosis.name=Seelendiagnose
seuchenweber.tree.seuchenweber_passive_soul_diagnosis.description=Passiv · Ab Level 70: Zeigt stark markierte Ziele nur ihrem Besitzer an.
seuchenweber.tree.seuchenweber_passive_relic_attunement.name=Reliktresonanz
seuchenweber.tree.seuchenweber_passive_relic_attunement.description=Passiv · Ab Level 90: Natürlich ablaufende volle Zeichen erstatten Ressourcen.
