# Endless Elite shared Hytale server localization.
# Single asset owner; feature sections retained from Hymann and Seuchenweber.

# --- Hymann ---
# Hymann item names and descriptions used by MMOSkillTree tooltips.
items.Hymann_Skill_XP.name = Stormbound Study
items.Hymann_Skill_XP.description = Increases experience gained from hits with Hymann armaments.
items.Hymann_Skill_Damage.name = Armament Mastery
items.Hymann_Skill_Damage.description = Increases flat damage dealt with Mjolnir, Captain shields and maces.
items.Hymann_Skill_Lifesteal.name = Storm Leech
items.Hymann_Skill_Lifesteal.description = Restores health from damage dealt with Hymann armaments.
items.Hymann_Skill_Combo.name = Thunder Combo
items.Hymann_Skill_Combo.description = Increases combo damage dealt with Hymann armaments.
items.Hymann_Skill_Cooldown.name = Storm Rhythm
items.Hymann_Skill_Cooldown.description = Reduces the cooldown of Hymann abilities.
items.Hymann_Skill_Stamina.name = Aegis Reserve
items.Hymann_Skill_Stamina.description = Increases maximum stamina for sustained melee combat and blocking.
items.Hymann_Skill_Fall_Guard.name = Skyfall Guard
items.Hymann_Skill_Fall_Guard.description = Reduces fall damage after leaps and aerial movement.
items.Hymann_Skill_Block.name = Aegis Guard
items.Hymann_Skill_Block.description = Reduces incoming damage and reinforces Hymann's shield-focused defense.
items.Hymann_Skill_Stamina_Regen.name = Windrunner
items.Hymann_Skill_Stamina_Regen.description = Increases stamina regeneration while using Hymann armaments.
items.Hymann_Skill_Mana_Regen.name = Stormwell
items.Hymann_Skill_Mana_Regen.description = Increases mana regeneration while using Hymann armaments.
items.Hymann_Skill_Sorcery.name = Lightning Lore
items.Hymann_Skill_Sorcery.description = Adds magic damage to Hymann lightning abilities.
items.Hymann_Skill_Crit.name = Thunderforged Fury
items.Hymann_Skill_Crit.description = Increases Hymann's critical damage.
items.Hymann_Skill_Thunder_Step.name = Lightning Step
items.Hymann_Skill_Thunder_Step.description = Teleport to a visible hostile enemy within 25 blocks, then deal 75 damage, stun for 1.5 seconds and shock enemies in a 6-block radius. Costs 35 Mana. Cooldown: 10 seconds.
items.Hymann_Skill_Storm_Fury.name = Storm Fury
items.Hymann_Skill_Storm_Fury.description = For 10 seconds, increase Mana and Signature Energy regeneration and reduce incoming damage. Costs 50 Mana. Cooldown: 20 seconds.
items.Hymann_Skill_Thunder_Aegis.name = Thunder Aegis
items.Hymann_Skill_Thunder_Aegis.description = Fully heal nearby allies and strike hostile enemies in a 9-block radius for 250 damage with a 2-second stun. Costs 75 Mana. Cooldown: 30 seconds.
items.Hymann_Skill_Stormbreaker.name = Stormbreaker
items.Hymann_Skill_Stormbreaker.description = Hymann passive ability: strengthens close-range lightning, survival and Mjolnir-and-shield combat.

# --- Seuchenweber ---
# Seuchenweber item names and descriptions.
items.Seuchenweber_Skill_XP.name=Seuchenweber
items.Seuchenweber_Skill_XP.description=Mastery of the Cosmic Ruin Spellbook and plague-woven abilities.
items.Seuchenweber_Skill_Seal_Of_Decay.name=Seal of Decay
items.Seuchenweber_Skill_Seal_Of_Decay.description=Imprint a hostile target with two Nekrotoxin stacks. The decay deals damage over time rather than burst damage.
items.Seuchenweber_Skill_Astral_Rift.name=Astral Rift
items.Seuchenweber_Skill_Astral_Rift.description=Step through a visible rift and leave a short-lived breach that infects nearby hostile creatures.
items.Seuchenweber_Skill_Chronoblight.name=Chronoblight
items.Seuchenweber_Skill_Chronoblight.description=Deepen your own existing marks. A fully marked target can be briefly controlled when Perfect Utils is available.
items.Seuchenweber_Skill_Necrotoxic_Mastery.name=Blight Breath
items.Seuchenweber_Skill_Necrotoxic_Mastery.description=Infects nearby enemies with one Nekrotoxin stack every 2 seconds.
items.Seuchenweber_Skill_Astral_Echo.name=Astral Echo
items.Seuchenweber_Skill_Astral_Echo.description=Allows a capped Nekrotoxin tick to mark one nearby hostile creature.
items.Seuchenweber_Skill_Soul_Diagnosis.name=Soul Diagnosis
items.Seuchenweber_Skill_Soul_Diagnosis.description=Reveals the state of heavily marked targets.
items.Seuchenweber_Skill_Relic_Attunement.name=Relic Attunement
items.Seuchenweber_Skill_Relic_Attunement.description=Naturally expiring full marks return a small amount of mana and cooldown time.
server.classes.seuchenweber.name=Seuchenweber
server.classes.seuchenweber.description=An occult mage who controls the fight with astral seals and owner-bound Nekrotoxin.
seuchenweber.tree.seuchenweber_seal_of_decay.name=Seal of Decay
seuchenweber.tree.seuchenweber_seal_of_decay.description=Active · Level 2: Marks a hostile target with Nekrotoxin.
seuchenweber.tree.seuchenweber_passive_necrotoxic_mastery.name=Blight Breath
seuchenweber.tree.seuchenweber_passive_necrotoxic_mastery.description=Passive · Level 1: Every 2 seconds, hostile targets within 8 blocks gain one Nekrotoxin stack.
seuchenweber.tree.seuchenweber_astral_rift.name=Astral Rift
seuchenweber.tree.seuchenweber_astral_rift.description=Active · Level 25: Teleports through a rift and infects nearby enemies.
seuchenweber.tree.seuchenweber_passive_astral_echo.name=Astral Echo
seuchenweber.tree.seuchenweber_passive_astral_echo.description=Passive · Level 40: Transfers a bounded mark to a nearby enemy.
seuchenweber.tree.seuchenweber_chronoblight.name=Chronoblight
seuchenweber.tree.seuchenweber_chronoblight.description=Active · Level 55: Deepens your own Nekrotoxin marks.
seuchenweber.tree.seuchenweber_passive_soul_diagnosis.name=Soul Diagnosis
seuchenweber.tree.seuchenweber_passive_soul_diagnosis.description=Passive · Level 70: Shows heavily marked targets only to their owner.
seuchenweber.tree.seuchenweber_passive_relic_attunement.name=Relic Attunement
seuchenweber.tree.seuchenweber_passive_relic_attunement.description=Passive · Level 90: Naturally expiring full marks refund resources.
