seuchenweber.tree.seuchenweber_passive_astral_echo.name = Astral Echo
seuchenweber.tree.seuchenweber_passive_astral_echo.description = Spreads owner-attributed Nekrotoxin to nearby enemies without recursive chains.
seuchenweber.tree.seuchenweber_chronoblight.name = Chronoblight
